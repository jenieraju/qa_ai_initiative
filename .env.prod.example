# BASE_URL and API_BASE_URL are REQUIRED for prod: settings.py only ships
# defaults for dev, so a run without these fails fast rather than
# silently pointing at the wrong host.
APP_ENV=prod
APP_NAME=APP_NAME

# BASE_URL=https://www.example.com
# API_BASE_URL=https://api.example.com

FEATURE_LOGIN_MOBILE_NUMBER=
FEATURE_LOGIN_OTP=
