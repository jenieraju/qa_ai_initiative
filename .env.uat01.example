# BASE_URL and API_BASE_URL are REQUIRED for uat01: settings.py only ships
# defaults for dev, so a run without these fails fast rather than
# silently pointing at the wrong host.
APP_ENV=uat01
APP_NAME=APP_NAME

# BASE_URL=https://uat01.example.com
# API_BASE_URL=https://api-uat01.example.com

FEATURE_LOGIN_MOBILE_NUMBER=
FEATURE_LOGIN_OTP=
