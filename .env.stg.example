# BASE_URL and API_BASE_URL are REQUIRED for stg: settings.py only ships
# defaults for dev, so a run without these fails fast rather than
# silently pointing at the wrong host.
APP_ENV=stg
APP_NAME=APP_NAME

# BASE_URL=https://stg.example.com
# API_BASE_URL=https://api-stg.example.com

FEATURE_LOGIN_MOBILE_NUMBER=
FEATURE_LOGIN_OTP=
