# Selects the active environment; overridden by pytest --env
APP_ENV=dev
APP_NAME=APP_NAME

# Optional explicit URL overrides (otherwise derived from ENV_URL_MAP in settings.py)
# BASE_URL=
# API_BASE_URL=
# ADMIN_PORTAL_URL=

DEFAULT_TIMEOUT_MS=30000
NAVIGATION_TIMEOUT_MS=60000

TARGET_BROWSER=chromium
HEADLESS=true
RECORD_VIDEO=false

# Credentials — never commit real values
CREDENTIALS_ENCRYPTION_KEY=
SHARED_ORG_ID=
SHARED_USER_EMAIL=
SHARED_USER_PASSWORD=

FEATURE_LOGIN_ORG_ID=
FEATURE_LOGIN_USER_EMAIL=
FEATURE_LOGIN_USER_PASSWORD=
