# Selects the active environment; overridden by pytest --env
APP_ENV=dev
APP_NAME=APP_NAME

# Optional explicit URL overrides (otherwise derived from ENV_URL_MAP in settings.py)
# BASE_URL=
# API_BASE_URL=
# ADMIN_PORTAL_URL=

DEFAULT_TIMEOUT_MS=30000
NAVIGATION_TIMEOUT_MS=60000

TARGET_BROWSER=chromium
HEADLESS=true
RECORD_VIDEO=false

# Bearer token for API-only setup/cleanup calls (src/core/api_client.py).
# Leave empty unless the target environment issues a static automation token.
API_TOKEN=

# Login is mobile number + OTP. SHARED_OTP only works if the target environment
# accepts a fixed/static OTP for automation (sandbox convention) — confirm with
# the app team before enabling the ignored login/onboarding tests.
SHARED_MOBILE_NUMBER=
SHARED_OTP=

FEATURE_LOGIN_MOBILE_NUMBER=
FEATURE_LOGIN_OTP=

# Onboarding — organization path KYC/bank verification test data
FEATURE_ONBOARDING_PAN=
FEATURE_ONBOARDING_GSTIN=
FEATURE_ONBOARDING_DOCUMENT_PATH=
FEATURE_ONBOARDING_BANK_ACCOUNT_NUMBER=
FEATURE_ONBOARDING_BANK_IFSC=

# Quick Collect — name of an existing member to use as the payer.
# Org data, not a fixture: point this at a real member on the target org.
FEATURE_QUICK_COLLECT_PAYER_NAME=
